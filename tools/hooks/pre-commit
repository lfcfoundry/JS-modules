#!/bin/sh
# Copyright (c) 2026 LFC Foundry. MIT License.
# Blocks the wrong author or committer early. Everything else here only WARNS (never blocks), unless noted:
#  - British spellings in added lines (AGENTS.md asks for American English). Put the text "spelling-ok" on a line to silence it for that line
#    (quoted source, proper names, CSS keywords). Whole words only, so identifiers such as colourMap or get_colour_value are not flagged.
#  - a NEW .js, .py or .sh file without "Copyright (c) 2026 LFC Foundry. MIT License" in its first 15 lines
#  - a NEW .html file that does not start with <!doctype html> and then the LFC Foundry header comment (tools/foundry-header.txt)
#    Set HOOKS_HEADER_STRICT=1 to make the two header checks block the commit instead of warning.
here=$(dirname "$0"); [ -f "$here/house-rules.sh" ] || here="$(git rev-parse --show-toplevel)/tools/hooks"
. "$here/house-rules.sh" || { echo "pre-commit: cannot read house-rules.sh next to this hook" >&2; exit 1; }
HR_PREFIX="pre-commit: "
hr_check_idents || exit 1

# --- spelling: whole words in added lines (plurals, -ed/-ing forms and the -ise/-isation family) ---
forms='colour(s|ed|ing|ful|less)?|behaviour(s|al|ally)?|centre(s|d)?|centring|grey(s|ed|ing|ish)?|favour(s|ed|ing|able)?|favourite(s)?|neighbour(s|ing|hood|hoods)?|honour(s|ed|ing|able)?|flavour(s|ed|ing)?|humour|labour(s|ed)?|armour|vapour|harbour|rumour|endeavour|defence(s)?|offence(s)?|licence(s|d)?|programme(s)?|catalogue(s|d)?|whilst|(centi|milli|kilo)?metre(s)?|litre(s)?|theatre(s)?|fibre(s)?|calibre|manoeuvre(s|d)?|tyre(s)?|kerb|plough(s|ed|ing)?|cheque(s)?|aluminium|artefact(s)?|ageing|judgement|analys(e|ed|ing|er|ers)'   # spelling-ok
verbs='optimis|initialis|serialis|deserialis|normalis|summaris|customis|minimis|maximis|organis|realis|recognis|synchronis|visualis|utilis|categoris|prioritis|authoris|finalis|generalis|specialis|standardis|randomis|sanitis|capitalis|emphasis|apologis|memoris|centralis|modernis|localis|tokenis|virtualis|stabilis|formalis|characteris|parameteris|materialis|harmonis|personalis|neutralis|rationalis|legalis|mobilis|equalis|familiaris|digitis|itemis|criticis|civilis|penalis|scrutinis'
words="($forms|($verbs)(e|es|ed|ing|ation|ations|ational|er|ers))"
# Left of the word: not a letter, digit or one of _ . $ # @ / -   Right of it: not a letter, digit or one of _ $ ( @ / -   (so names, calls and paths are left alone)
re="(^|[^a-z0-9_.\$#@/-])${words}([^a-z0-9_\$(@/-]|\$)"
# --src-prefix/--dst-prefix make the file header lines predictable; ACMR includes renamed (R) files that were also edited
git diff --cached -U0 --diff-filter=ACMR --no-color --src-prefix=a/ --dst-prefix=b/ | awk -v re="$re" '
  /^diff --git / { inhunk = 0; next }
  /^@@/ { inhunk = 1; next }
  !inhunk && /^\+\+\+ / { f = substr($0, 7); next }
  inhunk && /^\+/ {
    line = substr($0, 2)
    if (index(line, "spelling-ok")) next
    if (n < 5 && tolower(line) ~ re) { n++; printf "pre-commit (warning, not blocking): British spelling? %s: %s\n", f, substr(line, 1, 110) }
  }' >&2

# --- headers on NEW files only ---
missing=$(git -c core.quotePath=false diff --cached --name-only --diff-filter=A | while IFS= read -r f; do
  case "$f" in *.min.js|node_modules/*|*/node_modules/*|vendor/*|*/vendor/*) continue ;; esac
  case "$f" in
    *.js|*.py|*.sh)
      git show ":$f" 2>/dev/null | head -n 15 | grep -qF 'Copyright (c) 2026 LFC Foundry. MIT License' || echo "$f: no 'Copyright (c) 2026 LFC Foundry. MIT License' header in the first 15 lines" ;;
    *.html)
      git show ":$f" 2>/dev/null | awk '
        NR == 1 { l = tolower($0); if (l !~ /^<!doctype html>[ \t\r]*$/) bad = 1 }
        NR >= 2 && NR <= 3 && /<!--/ { c = 1 }
        NR <= 40 && /FORGED BY : LFC Foundry/ { g = 1 }
        END { exit (bad || !c || !g) }' || echo "$f: does not start with <!doctype html> and then the LFC Foundry header comment (tools/foundry-header.txt)" ;;
  esac
done)
if [ -n "$missing" ]; then
  printf '%s\n' "$missing" | while IFS= read -r m; do echo "pre-commit (header): $m" >&2; done
  if [ "$HOOKS_HEADER_STRICT" = 1 ]; then echo "pre-commit: HOOKS_HEADER_STRICT=1, so the missing header blocks this commit." >&2; exit 1; fi
fi
exit 0
