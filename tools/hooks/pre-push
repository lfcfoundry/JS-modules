#!/bin/sh
# Copyright (c) 2026 LFC Foundry. MIT License.
# Backstop for the commit-time hooks. Git runs this just before a push, with the pushed refs on standard input, and it applies the same
# message, author and committer rules (tools/hooks/house-rules.sh) to EVERY commit that is about to leave this clone. That catches what
# commit-msg never sees: commits rewritten by a rebase, commits copied by cherry-pick, and commits made before the hooks were installed.
# Only commits the remote does not have yet are checked, so old history already on the remote is not re-judged. That includes a commit another remote
# branch already holds (for example the merge commit GitHub makes for a merged pull request, whose committer is GitHub): it is not judged again when it
# first reaches the branch you push.
# Like every local hook, "git push --no-verify" skips it. Install once per clone: sh tools/hooks/install.sh
here=$(dirname "$0"); [ -f "$here/house-rules.sh" ] || here="$(git rev-parse --show-toplevel)/tools/hooks"
. "$here/house-rules.sh" || { echo "pre-push: cannot read house-rules.sh next to this hook" >&2; exit 1; }
tmp=$(mktemp) || { echo "pre-push: cannot make a temporary file" >&2; exit 1; }
trap 'rm -f "$tmp"' EXIT HUP INT TERM
HR_PREFIX="    - "; bad=0; checked=0; shown=0
while read -r lref lsha rref rsha; do
  case "$lsha" in *[!0]*) ;; *) continue ;; esac                      # deleting a branch or tag: nothing is sent
  case "$rsha" in
    *[!0]*) if git cat-file -e "$rsha^{commit}" 2>/dev/null; then range="$lsha --not $rsha --remotes"; else range="$lsha --not --remotes"; fi ;;   # existing branch
    *) range="$lsha --not --remotes" ;;                                # new branch: what no known remote branch has yet
  esac
  for sha in $(git rev-list $range 2>/dev/null); do
    checked=$((checked + 1))
    if ! out=$(hr_commit "$sha" "$tmp" 2>&1); then
      bad=$((bad + 1))
      if [ "$shown" -lt 10 ]; then
        shown=$((shown + 1))
        echo "pre-push: commit $(git log -1 --format='%h %s' "$sha" | cut -c1-90) breaks the house rules:" >&2
        printf '%s\n' "$out" >&2
      fi
    fi
  done
done
if [ "$bad" -gt 0 ]; then
  [ "$bad" -gt "$shown" ] && echo "pre-push: ... and $((bad - shown)) more commit(s)." >&2
  echo "pre-push: $bad of $checked outgoing commit(s) break the house rules (AGENTS.md), so nothing was pushed." >&2
  echo "pre-push: to fix the author and committer of the last N commits (the owner): git config user.name $HR_NAME && git config user.email $HR_MAIL &&" >&2
  echo "          git rebase --exec 'git commit --amend --no-edit --reset-author' HEAD~N     (a message needs 'git rebase -i HEAD~N' and 'reword')." >&2
  exit 1
fi
exit 0
