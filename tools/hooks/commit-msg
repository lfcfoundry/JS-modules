#!/bin/sh
# Copyright (c) 2026 LFC Foundry. MIT License.
# House rules, checked by a machine instead of by memory (see AGENTS.md and tools/hooks/house-rules.sh):
#  - no "Claude-Session:" line and no claude.ai link in a commit message (a "#" line is checked too; only git's own template comment block is skipped)
#  - author and committer are JNFoo with the noreply address
#  - any version stamp in the message is year.month.day.HHMM
# A Co-Authored-By trailer is fine. Install once per clone: sh tools/hooks/install.sh
here=$(dirname "$0"); [ -f "$here/house-rules.sh" ] || here="$(git rev-parse --show-toplevel)/tools/hooks"
. "$here/house-rules.sh" || { echo "commit-msg: cannot read house-rules.sh next to this hook" >&2; exit 1; }
HR_PREFIX="commit-msg: "; bad=0
hr_message "$1" template || bad=1
hr_check_idents || bad=1
exit $bad
